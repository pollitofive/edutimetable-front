# Copiar a .env.e2e (no se commitea). Lo lee scripts/e2e.sh.

# Local: usuario del seed de edutimetable-api (el business con datos)
E2E_USER_EMAIL=admin@example.com
E2E_USER_PASSWORD=password

# Staging (npm run e2e:staging): basic-auth del front y un usuario de su base
E2E_BASIC_AUTH_USER=
E2E_BASIC_AUTH_PASS=
E2E_STAGING_USER_EMAIL=
E2E_STAGING_USER_PASSWORD=
