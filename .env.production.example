# Plantilla del .env de staging/prod en el VPS (/srv/edutimetable/<env>/front/.env).

COMPOSE_PROJECT_NAME=edutimetable-<env>-front
APP_DOMAIN=<front.dominio>

VITE_API_URL=https://<api.dominio>/api
VITE_GRAPHQL_URL=https://<api.dominio>/api/graphql
VITE_PROJECT_NAME=Edutimetable

# Solo staging (docker-compose.staging.yml). Formato htpasswd: htpasswd -nbB usuario clave
# Va entre comillas SIMPLES: sin ellas compose interpola los $ del hash y la clave queda vacía.
BASIC_AUTH_USERS='usuario:$2y$05$...'
